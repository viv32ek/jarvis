# Core Brain (uses your existing Antigravity CLI account credits)
JARVIS_MODEL=gemini-3.8-flash-medium
JARVIS_CODE_MODEL=gemini-4-neon-medium
JARVIS_AGY_BIN=agy
# Agent execution modes (auto | accept-edits | plan)
JARVIS_AGY_MODE=auto
JARVIS_CODE_MODE=auto

# Phase 3A: Local Web UI
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8765

# Phase 3C: Telegram Bot (100% free via @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=

# Phase 4: Home Assistant (100% free local REST API)
HOME_ASSISTANT_URL=http://homeassistant.local:8123
HOME_ASSISTANT_TOKEN=

# Phase 4: Gmail (100% free personal Google Cloud OAuth)
GMAIL_CREDENTIALS_PATH=credentials.json
GMAIL_TOKEN_PATH=token.json
