{
  "jarvis-deploy-guard": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ../jarvis/deploy_guard.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
